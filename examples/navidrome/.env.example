# Absolute path to your existing MP3, FLAC, AAC, etc. collection.
MUSIC_PATH=/absolute/path/to/your/music
# This folder stores the server database and artwork/transcoding cache.
DATA_PATH=./data
# On Linux, use the output of id -u and id -g for the account owning DATA_PATH.
NAVIDROME_UID=1000
NAVIDROME_GID=1000
# Start locally to create your account. Then use your server's LAN address
# (or 0.0.0.0 on a trusted home LAN) to connect from your phone.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=4533
